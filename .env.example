# Public site URL used by metadata, sitemap and canonical links.
NEXT_PUBLIC_SITE_URL=https://fazhi.example.edu.cn

# Optional: enables model-generated answers. Without it, the API returns a
# deterministic retrieval summary and still cites local knowledge sources.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional: comma-separated trusted origins for API POST requests.
ALLOWED_ORIGINS=https://fazhi.example.edu.cn
